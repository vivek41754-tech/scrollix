# ==============================================================
# SCROLLIX AI - ENVIRONMENT & CONFIGURATION TEMPLATE
# Copy this file to '.env' to customize local or cloud options.
# Core features (YOLOv11, CLIP, FAISS, hybrid recommender, sentiment)
# run 100% locally with zero paid API dependencies!
# ==============================================================

# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1

# Storage Directory for SQLite DB, uploads, and FAISS vector index
# If empty, automatically defaults to ./data (portable) or %APPDATA%/ScrollixData (packaged)
SCROLLIX_DATA_DIR=

# Database Configuration
# Local Standalone default: sqlite:///./data/scrollix.db
# Cloud PostgreSQL example: postgresql://user:password@localhost:5432/scrollix
DATABASE_URL=sqlite:///./data/scrollix.db

# JWT Security Secret (Generate a strong random string in production)
JWT_SECRET_KEY=scrollix-production-jwt-secret-replace-in-cloud-deployment-2026

# Optional: Google Gemini Cloud API (Free Tier available at aistudio.google.com)
# When left blank, Scrollix AI automatically utilizes its built-in local catalogue assistant.
GEMINI_API_KEY=

# Optional: Firebase Authentication (Only needed if configuring Firebase SSO)
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
